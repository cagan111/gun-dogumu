# Veritabanı
DATABASE_URL=postgresql://randevu:randevu@localhost:5432/randevu
# Auth.js (openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Alan adı (boşsa Caddy :80 üzerinden HTTP)
APP_DOMAIN=
SUPERADMIN_EMAIL=admin@example.com
# Mesajlaşma: mock | netgsm | iletimerkezi | generic_http
SMS_PROVIDER=mock
ALLOW_REAL_SMS=false
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=
ILETIMERKEZI_KEY=
ILETIMERKEZI_HASH=
ILETIMERKEZI_SENDER=
GENERIC_SMS_URL=
GENERIC_SMS_METHOD=POST
GENERIC_SMS_TOKEN=
# GENERIC_SMS_PARAMS: yer tutucular {to} {text} {sender} {token}; "{" ile başlarsa JSON, yoksa form/sorgu (ör. to={to}&msg={text})
GENERIC_SMS_PARAMS=
GENERIC_SMS_TOKEN_HEADER=
GENERIC_SMS_OK_REGEX=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta'da onaylı, gövdesi tek {{1}} parametreli şablon
WHATSAPP_TEMPLATE=kr_notification
WHATSAPP_LANG=tr
# İş kuyruğu: pgboss (varsayılan) | none
JOBS_QUEUE=pgboss
# Opsiyonel yapay zekâ özellikleri
AI_API_KEY=
# Pazarlama sitesindeki WhatsApp butonu (E.164)
CONTACT_WHATSAPP=
# true ise ilk açılışta demo verisi yüklenir
SEED_DEMO=false
LOG_LEVEL=info
# --- Docker Compose ---
# Postgres (compose içindeki db servisi; DATABASE_URL compose tarafından bu değerlerden kurulur)
POSTGRES_USER=randevu
POSTGRES_PASSWORD=
POSTGRES_DB=randevu
# Yedek (backup servisi): kaç gün tutulsun
BACKUP_KEEP_DAYS=14
