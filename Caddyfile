# Site adresi CADDY_SITE ortam değişkeninden gelir (docker-compose.yml, APP_DOMAIN'den türetir):
#   APP_DOMAIN=randevu.ornek.com  → CADDY_SITE=randevu.ornek.com  → otomatik HTTPS (Let's Encrypt, 80/443)
#   APP_DOMAIN boş               → CADDY_SITE=:80                → yalnız HTTP (yerel/deneme, IP ile erişim)
{$CADDY_SITE::80} {
	encode zstd gzip
	reverse_proxy app:3000 {
		health_uri /api/health
		health_interval 15s
	}
	log {
		output stdout
		format json
	}
}
