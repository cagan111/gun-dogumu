# Runtime proxy warnings can contain upstream request headers as well as access logs.
{
 log default {
  format filter {
   wrap json
   fields {
    # Opaque and future token routes: omit the whole URI instead of fragile route matching.
    request>uri delete
    request>headers>Referer delete
    resp_headers>Location delete
    request>headers>X-Kr-Proxy-Token delete
    request>headers>Cookie delete
    request>headers>Authorization delete
   }
  }
 }
}
# Site adresi CADDY_SITE ortam değişkeninden gelir (docker-compose.yml, APP_DOMAIN'den türetir):
#   APP_DOMAIN=randevu.ornek.com  → CADDY_SITE=randevu.ornek.com  → otomatik HTTPS (Let's Encrypt, 80/443)
#   APP_DOMAIN boş               → CADDY_SITE=:80                → yalnız HTTP (yerel/deneme, IP ile erişim)
{$CADDY_SITE::80} {
	encode zstd gzip
	# Do not infer HTTPS from client-controlled forwarded headers.
	@tls protocol https
	header @tls Strict-Transport-Security "max-age=31536000"
	request_body {
		max_size 1048576
	}
	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-KR-Proxy-Token {$PROXY_SHARED_SECRET}
		health_uri /api/health
		health_interval 15s
	}
	log {
		output stdout
		format filter {
			wrap json
			fields {
			 # Opaque and future token routes: omit the whole URI instead of fragile route matching.
			 request>uri delete
			 request>headers>Referer delete
			 resp_headers>Location delete
				request>headers>X-Kr-Proxy-Token delete
				request>headers>Cookie delete
				request>headers>Authorization delete
			}
		}
	}
}
